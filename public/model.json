{"songs":[{"title":"House of the Rising Sun","note":"Traditional American folk, known by 1905. No author."},{"title":"Scarborough Fair","note":"English ballad, 17th-century broadside origin."},{"title":"Amazing Grace","note":"Words John Newton 1779, tune 1831."},{"title":"Oh! Susanna","note":"Stephen Foster, published 1848."},{"title":"Oh My Darling, Clementine","note":"American western ballad, credited 1884."},{"title":"Red River Valley","note":"Cowboy standard, earliest manuscript 1879."},{"title":"Down by the Riverside","note":"African-American spiritual, slavery-era roots."},{"title":"Take Me Out to the Ball Game","note":"Norworth and Von Tilzer, 1908."},{"title":"Auld Lang Syne","note":"Robert Burns 1788, old Scots air."},{"title":"Greensleeves","note":"English ballad, registered 1580."},{"title":"Shenandoah","note":"American sea shanty, first print 1876."},{"title":"Simple Gifts","note":"Shaker song, Joseph Brackett 1848."},{"title":"Home on the Range","note":"Words Higley 1873, Kansas state song."},{"title":"I Have Been Working on the Railroad","note":"American folk medley, first print 1894."},{"title":"Yankee Doodle","note":"Anglo-American, sung before the Revolution."},{"title":"When the Saints Go Marching In","note":"New Orleans folk origin, first print 1896."}],"lines":[{"s":0,"text":"There is a house in New Orleans","terms":["there","house","new","orleans"]},{"s":0,"text":"They call it the Rising Sun,","terms":["call","rising","sun"]},{"s":0,"text":"And it has been the ruin of many a poor girl,","terms":["ruin","many","poor","girl"]},{"s":0,"text":"And me, oh God, I am one.","terms":["oh","god","one"]},{"s":0,"text":"If I had only listened to what my mama said,","terms":["if","only","listened","what","mama","said"]},{"s":0,"text":"I would be at home today.","terms":["home","today"]},{"s":0,"text":"But being so young and foolish, my Lord,","terms":["young","foolish","lord"]},{"s":0,"text":"Let a gambler lead me astray.","terms":["let","gambler","lead","astray"]},{"s":0,"text":"Now, my mother is a tailor,","terms":["now","mother","tailor"]},{"s":0,"text":"She sews those new blue jeans.","terms":["sews","those","new","blue","jeans"]},{"s":0,"text":"And my sweetheart is a drunkard, Lord,","terms":["sweetheart","drunkard","lord"]},{"s":0,"text":"Drinks down in New Orleans.","terms":["drinks","down","new","orleans"]},{"s":0,"text":"Now the only thing a drunkard needs","terms":["now","only","thing","drunkard","needs"]},{"s":0,"text":"Is a suitcase and a trunk.","terms":["suitcase","trunk"]},{"s":0,"text":"And the only time he is satisfied,","terms":["only","time","satisfied"]},{"s":0,"text":"Lord, is when he is on the drunk.","terms":["lord","when","drunk"]},{"s":0,"text":"Go tell my baby sister","terms":["go","tell","baby","sister"]},{"s":0,"text":"Not to do what I have done.","terms":["what","done"]},{"s":0,"text":"But shun that house in New Orleans","terms":["shun","house","new","orleans"]},{"s":0,"text":"They call it the Rising Sun.","terms":["call","rising","sun"]},{"s":0,"text":"Well, I am going back to New Orleans;","terms":["well","going","back","new","orleans"]},{"s":0,"text":"My race is almost run.","terms":["race","almost","run"]},{"s":0,"text":"Yes, I am going back to spend my life","terms":["yes","going","back","spend","life"]},{"s":0,"text":"Beneath the rising sun.","terms":["beneath","rising","sun"]},{"s":1,"text":"Are you going to Scarborough Fair?","terms":["going","scarborough","fair"]},{"s":1,"text":"Parsley, sage, rosemary and thyme.","terms":["parsley","sage","rosemary","thyme"]},{"s":1,"text":"Remember me to one who lives there,","terms":["remember","one","who","lives","there"]},{"s":1,"text":"She once was a true love of mine.","terms":["once","was","true","love","mine"]},{"s":1,"text":"Tell her to make me a cambric shirt,","terms":["tell","make","cambric","shirt"]},{"s":1,"text":"Parsley, sage, rosemary and thyme,","terms":["parsley","sage","rosemary","thyme"]},{"s":1,"text":"Without no seam nor needlework,","terms":["without","no","seam","nor","needlework"]},{"s":1,"text":"Then she will be a true love of mine.","terms":["then","true","love","mine"]},{"s":1,"text":"Tell her to find me an acre of land,","terms":["tell","find","acre","land"]},{"s":1,"text":"Parsley, sage, rosemary and thyme,","terms":["parsley","sage","rosemary","thyme"]},{"s":1,"text":"Between the salt water and the sea strand,","terms":["between","salt","water","sea","strand"]},{"s":1,"text":"Then she will be a true love of mine.","terms":["then","true","love","mine"]},{"s":1,"text":"Tell her to reap it with a sickle of leather,","terms":["tell","reap","sickle","leather"]},{"s":1,"text":"Parsley, sage, rosemary and thyme,","terms":["parsley","sage","rosemary","thyme"]},{"s":1,"text":"And gather it all in a bunch of heather,","terms":["gather","all","bunch","heather"]},{"s":1,"text":"Then she will be a true love of mine.","terms":["then","true","love","mine"]},{"s":2,"text":"Amazing grace! how sweet the sound,","terms":["amazing","grace","how","sweet","sound"]},{"s":2,"text":"That saved a wretch like me!","terms":["saved","wretch","like"]},{"s":2,"text":"I once was lost, but now am found,","terms":["once","was","lost","now","found"]},{"s":2,"text":"Was blind, but now I see.","terms":["was","blind","now","see"]},{"s":2,"text":"It was grace that taught my heart to fear,","terms":["was","grace","taught","heart","fear"]},{"s":2,"text":"And grace my fears relieved;","terms":["grace","fears","relieved"]},{"s":2,"text":"How precious did that grace appear","terms":["how","precious","grace","appear"]},{"s":2,"text":"The hour I first believed!","terms":["hour","first","believed"]},{"s":2,"text":"Through many dangers, toils and snares,","terms":["through","many","dangers","toils","snares"]},{"s":2,"text":"I have already come;","terms":["already","come"]},{"s":2,"text":"It is grace that brought me safe thus far,","terms":["grace","brought","safe","thus","far"]},{"s":2,"text":"And grace will lead me home.","terms":["grace","lead","home"]},{"s":2,"text":"When we have been there ten thousand years,","terms":["when","there","ten","thousand","years"]},{"s":2,"text":"Bright shining as the sun,","terms":["bright","shining","sun"]},{"s":2,"text":"We have no less days to sing praise","terms":["no","less","days","sing","praise"]},{"s":2,"text":"Than when we first begun.","terms":["than","when","first","begun"]},{"s":3,"text":"I came from Alabama with my banjo on my knee,","terms":["came","alabama","banjo","knee"]},{"s":3,"text":"I am going to Louisiana, my true love for to see.","terms":["going","louisiana","true","love","see"]},{"s":3,"text":"It rained all night the day I left, the weather it was dry,","terms":["rained","all","night","day","left","weather","was","dry"]},{"s":3,"text":"The sun so hot I froze to death, Susanna, do not you cry.","terms":["sun","hot","froze","death","susanna","cry"]},{"s":3,"text":"Oh! Susanna, oh! do not you cry for me,","terms":["oh","susanna","cry"]},{"s":3,"text":"For I have come from Alabama with my banjo on my knee.","terms":["come","alabama","banjo","knee"]},{"s":4,"text":"In a cavern, in a canyon, excavating for a mine,","terms":["cavern","canyon","excavating","mine"]},{"s":4,"text":"Dwelt a miner, forty-niner, and his daughter Clementine.","terms":["dwelt","miner","forty","niner","daughter","clementine"]},{"s":4,"text":"Oh my darling, oh my darling, oh my darling Clementine,","terms":["oh","darling","clementine"]},{"s":4,"text":"You are lost and gone forever, dreadful sorry, Clementine.","terms":["lost","gone","forever","dreadful","sorry","clementine"]},{"s":4,"text":"Light she was and like a fairy, and her shoes were number nine,","terms":["light","was","like","fairy","shoes","number","nine"]},{"s":4,"text":"Herring boxes without tops, sandals were for Clementine.","terms":["herring","boxes","without","tops","sandals","clementine"]},{"s":4,"text":"Drove she ducklings to the water, every morning just at nine,","terms":["drove","ducklings","water","every","morning","just","nine"]},{"s":4,"text":"Hit her foot against a splinter, fell into the foaming brine.","terms":["hit","foot","against","splinter","fell","into","foaming","brine"]},{"s":4,"text":"Ruby lips above the water, blowing bubbles soft and fine,","terms":["ruby","lips","above","water","blowing","bubbles","soft","fine"]},{"s":4,"text":"Alas for me, I was no swimmer, so I lost my Clementine.","terms":["alas","was","no","swimmer","lost","clementine"]},{"s":4,"text":"In a churchyard near the canyon, where the myrtle does entwine,","terms":["churchyard","near","canyon","where","myrtle","entwine"]},{"s":4,"text":"There grow roses and other posies, fertilized by Clementine.","terms":["there","grow","roses","other","posies","fertilized","clementine"]},{"s":5,"text":"From this valley they say you are going,","terms":["valley","say","going"]},{"s":5,"text":"We will miss your bright eyes and sweet smile,","terms":["miss","bright","eyes","sweet","smile"]},{"s":5,"text":"For they say you are taking the sunshine","terms":["say","taking","sunshine"]},{"s":5,"text":"That has brightened our pathway awhile.","terms":["brightened","our","pathway","awhile"]},{"s":5,"text":"Come and sit by my side if you love me,","terms":["come","sit","side","if","love"]},{"s":5,"text":"Do not hasten to bid me adieu,","terms":["hasten","bid","adieu"]},{"s":5,"text":"But remember the Red River Valley","terms":["remember","red","river","valley"]},{"s":5,"text":"And the cowboy who loved you so true.","terms":["cowboy","who","loved","true"]},{"s":5,"text":"I have been thinking a long time, my darling,","terms":["thinking","long","time","darling"]},{"s":5,"text":"Of the sweet words you never would say,","terms":["sweet","words","never","say"]},{"s":5,"text":"Now alas, must my fond hopes all vanish,","terms":["now","alas","must","fond","hopes","all","vanish"]},{"s":5,"text":"For they say you are going away.","terms":["say","going","away"]},{"s":5,"text":"Do you think of the valley you are leaving,","terms":["think","valley","leaving"]},{"s":5,"text":"Oh how lonely and how dreary it will be?","terms":["oh","how","lonely","dreary"]},{"s":5,"text":"Do you think of the kind hearts you are breaking,","terms":["think","kind","hearts","breaking"]},{"s":5,"text":"And the pain you are causing to me?","terms":["pain","causing"]},{"s":6,"text":"Going to lay down my sword and shield","terms":["going","lay","down","sword","shield"]},{"s":6,"text":"Down by the riverside,","terms":["down","riverside"]},{"s":6,"text":"Down by the riverside,","terms":["down","riverside"]},{"s":6,"text":"Down by the riverside,","terms":["down","riverside"]},{"s":6,"text":"Going to lay down my sword and shield","terms":["going","lay","down","sword","shield"]},{"s":6,"text":"Down by the riverside,","terms":["down","riverside"]},{"s":6,"text":"I am not going to study war no more.","terms":["going","study","war","no","more"]},{"s":6,"text":"I am not going to study war no more,","terms":["going","study","war","no","more"]},{"s":6,"text":"I am not going to study war no more.","terms":["going","study","war","no","more"]},{"s":6,"text":"Going to put on my long white robe","terms":["going","put","long","white","robe"]},{"s":6,"text":"Down by the riverside,","terms":["down","riverside"]},{"s":6,"text":"Going to shake hands with all my friends","terms":["going","shake","hands","all","friends"]},{"s":6,"text":"Down by the riverside,","terms":["down","riverside"]},{"s":7,"text":"Katie Casey was baseball mad, had the fever and had it bad,","terms":["katie","casey","was","baseball","mad","fever","bad"]},{"s":7,"text":"Just to root for the hometown crew, every cent Katie blew.","terms":["just","root","hometown","crew","every","cent","katie","blew"]},{"s":7,"text":"On a Saturday her young beau called to see if she would like to go,","terms":["saturday","young","beau","called","see","if","like","go"]},{"s":7,"text":"To see a show, but Miss Kate said No, I will tell you what you can do:","terms":["see","show","miss","kate","said","no","tell","what"]},{"s":7,"text":"Take me out to the ball game, take me out with the crowd,","terms":["take","out","ball","game","crowd"]},{"s":7,"text":"Buy me some peanuts and Cracker Jack, I do not care if I never get back,","terms":["buy","some","peanuts","cracker","jack","care","if","never","get","back"]},{"s":7,"text":"Let me root, root, root for the home team, if they do not win it is a shame,","terms":["let","root","home","team","if","win","shame"]},{"s":7,"text":"For it is one, two, three strikes you are out at the old ball game.","terms":["one","two","three","strikes","out","old","ball","game"]},{"s":8,"text":"Should old acquaintance be forgot,","terms":["old","acquaintance","forgot"]},{"s":8,"text":"And never brought to mind?","terms":["never","brought","mind"]},{"s":8,"text":"Should old acquaintance be forgot,","terms":["old","acquaintance","forgot"]},{"s":8,"text":"And days of long ago?","terms":["days","long","ago"]},{"s":8,"text":"For days of long ago, my dear,","terms":["days","long","ago","dear"]},{"s":8,"text":"For days of long ago,","terms":["days","long","ago"]},{"s":8,"text":"We will take a cup of kindness yet","terms":["take","cup","kindness","yet"]},{"s":8,"text":"For days of long ago.","terms":["days","long","ago"]},{"s":8,"text":"And surely you will buy your pint,","terms":["surely","buy","pint"]},{"s":8,"text":"And surely I will buy mine!","terms":["surely","buy","mine"]},{"s":8,"text":"And we will take a cup of kindness yet","terms":["take","cup","kindness","yet"]},{"s":8,"text":"For days of long ago.","terms":["days","long","ago"]},{"s":9,"text":"Alas, my love, you do me wrong","terms":["alas","love","wrong"]},{"s":9,"text":"To cast me off discourteously,","terms":["cast","off","discourteously"]},{"s":9,"text":"For I have loved you well and long,","terms":["loved","well","long"]},{"s":9,"text":"Delighting in your company.","terms":["delighting","company"]},{"s":9,"text":"Greensleeves was all my joy,","terms":["greensleeves","was","all","joy"]},{"s":9,"text":"Greensleeves was my delight,","terms":["greensleeves","was","delight"]},{"s":9,"text":"Greensleeves was my heart of gold,","terms":["greensleeves","was","heart","gold"]},{"s":9,"text":"And who but my lady Greensleeves.","terms":["who","lady","greensleeves"]},{"s":9,"text":"I have been ready at your hand","terms":["ready","hand"]},{"s":9,"text":"To grant whatever you would crave,","terms":["grant","whatever","crave"]},{"s":9,"text":"I have both wagered life and land,","terms":["both","wagered","life","land"]},{"s":9,"text":"Your love and good-will for to have.","terms":["love","good"]},{"s":10,"text":"Oh Shenandoah, I long to hear you,","terms":["oh","shenandoah","long","hear"]},{"s":10,"text":"Away, you rolling river,","terms":["away","rolling","river"]},{"s":10,"text":"Oh Shenandoah, I long to hear you,","terms":["oh","shenandoah","long","hear"]},{"s":10,"text":"Away, I am bound away across the wide Missouri.","terms":["away","bound","across","wide","missouri"]},{"s":10,"text":"Oh Shenandoah, I love your daughter,","terms":["oh","shenandoah","love","daughter"]},{"s":10,"text":"Away, you rolling river,","terms":["away","rolling","river"]},{"s":10,"text":"For her I have crossed the rolling water,","terms":["crossed","rolling","water"]},{"s":10,"text":"Away, I am bound away across the wide Missouri.","terms":["away","bound","across","wide","missouri"]},{"s":10,"text":"It is seven years since last I have seen you,","terms":["seven","years","since","last","seen"]},{"s":10,"text":"Away, you rolling river,","terms":["away","rolling","river"]},{"s":10,"text":"It is seven years since last I have seen you,","terms":["seven","years","since","last","seen"]},{"s":10,"text":"Away, I am bound away across the wide Missouri.","terms":["away","bound","across","wide","missouri"]},{"s":10,"text":"Farewell, my dear, I am bound to leave you,","terms":["farewell","dear","bound","leave"]},{"s":10,"text":"Away, you rolling river,","terms":["away","rolling","river"]},{"s":10,"text":"Oh Shenandoah, I will not deceive you,","terms":["oh","shenandoah","deceive"]},{"s":10,"text":"Away, I am bound away across the wide Missouri.","terms":["away","bound","across","wide","missouri"]},{"s":11,"text":"It is the gift to be simple, it is the gift to be free,","terms":["gift","simple","free"]},{"s":11,"text":"It is the gift to come down where we ought to be,","terms":["gift","come","down","where","ought"]},{"s":11,"text":"And when we find ourselves in the place just right,","terms":["when","find","ourselves","place","just","right"]},{"s":11,"text":"It will be in the valley of love and delight.","terms":["valley","love","delight"]},{"s":11,"text":"When true simplicity is gained,","terms":["when","true","simplicity","gained"]},{"s":11,"text":"To bow and to bend we shall not be ashamed,","terms":["bow","bend","shall","ashamed"]},{"s":11,"text":"To turn, turn will be our delight,","terms":["turn","our","delight"]},{"s":11,"text":"Till by turning, turning we come round right.","terms":["till","turning","come","round","right"]},{"s":12,"text":"Oh, give me a home where the buffalo roam,","terms":["oh","give","home","where","buffalo","roam"]},{"s":12,"text":"Where the deer and the antelope play,","terms":["where","deer","antelope","play"]},{"s":12,"text":"Where seldom is heard a discouraging word","terms":["where","seldom","heard","discouraging","word"]},{"s":12,"text":"And the skies are not cloudy all day.","terms":["skies","cloudy","all","day"]},{"s":12,"text":"Home, home on the range,","terms":["home","range"]},{"s":12,"text":"Where the deer and the antelope play,","terms":["where","deer","antelope","play"]},{"s":12,"text":"Where seldom is heard a discouraging word","terms":["where","seldom","heard","discouraging","word"]},{"s":12,"text":"And the skies are not cloudy all day.","terms":["skies","cloudy","all","day"]},{"s":12,"text":"How often at night when the heavens are bright","terms":["how","often","night","when","heavens","bright"]},{"s":12,"text":"With the light from the glittering stars,","terms":["light","glittering","stars"]},{"s":12,"text":"Have I stood there amazed and asked as I gazed","terms":["stood","there","amazed","asked","gazed"]},{"s":12,"text":"If their glory exceeds that of ours.","terms":["if","glory","exceeds","ours"]},{"s":13,"text":"I have been working on the railroad","terms":["working","railroad"]},{"s":13,"text":"All the livelong day,","terms":["all","livelong","day"]},{"s":13,"text":"I have been working on the railroad","terms":["working","railroad"]},{"s":13,"text":"Just to pass the time away.","terms":["just","pass","time","away"]},{"s":13,"text":"Can you not hear the whistle blowing,","terms":["hear","whistle","blowing"]},{"s":13,"text":"Rise up so early in the morn?","terms":["rise","up","early","morn"]},{"s":13,"text":"Can you not hear the captain shouting,","terms":["hear","captain","shouting"]},{"s":13,"text":"Dinah, blow your horn?","terms":["dinah","blow","horn"]},{"s":13,"text":"Dinah, will you not blow,","terms":["dinah","blow"]},{"s":13,"text":"Dinah, will you not blow,","terms":["dinah","blow"]},{"s":13,"text":"Dinah, will you not blow your horn?","terms":["dinah","blow","horn"]},{"s":13,"text":"Someone is in the kitchen with Dinah,","terms":["someone","kitchen","dinah"]},{"s":13,"text":"Someone is in the kitchen, I know,","terms":["someone","kitchen","know"]},{"s":13,"text":"Someone is in the kitchen with Dinah,","terms":["someone","kitchen","dinah"]},{"s":13,"text":"Strumming on the old banjo.","terms":["strumming","old","banjo"]},{"s":14,"text":"Yankee Doodle went to town","terms":["yankee","doodle","went","town"]},{"s":14,"text":"A-riding on a pony,","terms":["riding","pony"]},{"s":14,"text":"Stuck a feather in his cap","terms":["stuck","feather","cap"]},{"s":14,"text":"And called it macaroni.","terms":["called","macaroni"]},{"s":14,"text":"Yankee Doodle keep it up,","terms":["yankee","doodle","keep","up"]},{"s":14,"text":"Yankee Doodle dandy,","terms":["yankee","doodle","dandy"]},{"s":14,"text":"Mind the music and the step","terms":["mind","music","step"]},{"s":14,"text":"And with the girls be handy.","terms":["girls","handy"]},{"s":14,"text":"Father and I went down to camp","terms":["father","went","down","camp"]},{"s":14,"text":"Along with Captain Gooding,","terms":["along","captain","gooding"]},{"s":14,"text":"And there we saw the men and boys","terms":["there","saw","men","boys"]},{"s":14,"text":"As thick as hasty pudding.","terms":["thick","hasty","pudding"]},{"s":15,"text":"Oh, when the saints go marching in,","terms":["oh","when","saints","go","marching"]},{"s":15,"text":"Oh, when the saints go marching in,","terms":["oh","when","saints","go","marching"]},{"s":15,"text":"Oh Lord, I want to be in that number","terms":["oh","lord","want","number"]},{"s":15,"text":"When the saints go marching in.","terms":["when","saints","go","marching"]},{"s":15,"text":"Oh, when the drums begin to bang,","terms":["oh","when","drums","begin","bang"]},{"s":15,"text":"Oh, when the stars fall from the sky,","terms":["oh","when","stars","fall","sky"]},{"s":15,"text":"Oh, when the moon turns red with blood,","terms":["oh","when","moon","turns","red","blood"]}],"idf":{"there":3.531250509910353,"house":4.629862798578463,"new":3.713572066704308,"orleans":3.9367156180185177,"call":4.629862798578463,"rising":4.2243976904702984,"sun":3.713572066704308,"ruin":5.3230099791384085,"many":4.629862798578463,"poor":5.3230099791384085,"girl":5.3230099791384085,"oh":2.614959778036198,"god":5.3230099791384085,"one":4.2243976904702984,"if":3.531250509910353,"only":4.2243976904702984,"listened":5.3230099791384085,"what":4.2243976904702984,"mama":5.3230099791384085,"said":4.629862798578463,"home":3.713572066704308,"today":5.3230099791384085,"young":4.629862798578463,"foolish":5.3230099791384085,"lord":3.9367156180185177,"let":4.629862798578463,"gambler":5.3230099791384085,"lead":4.629862798578463,"astray":5.3230099791384085